,{"stream_name":"stdout","time":242.560098166,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":242.560103647,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":242.560108883,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":242.560129406,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":242.560135881,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":242.560139842,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":242.56014534,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":242.560150434,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":242.560155103,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":242.560159818,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":242.560168788,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":242.560172961,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":242.560177025,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":242.560184732,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":242.560188956,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":242.560193178,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":242.560197348,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":242.560201568,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":242.560205493,"data":"end\n"}
