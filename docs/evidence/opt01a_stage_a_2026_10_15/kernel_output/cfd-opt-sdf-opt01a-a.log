,{"stream_name":"stdout","time":236.394932089,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":236.394936672,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":236.394940757,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":236.394958966,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":236.394975017,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":236.394978686,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":236.394982785,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":236.394987136,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":236.394990509,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":236.394993754,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":236.394997169,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":236.395000576,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":236.395003952,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":236.395007237,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":236.395010719,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":236.395014311,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":236.395017646,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":236.395021237,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":236.395024487,"data":"end\n"}
