,{"stream_name":"stdout","time":237.579642525,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":237.57964972,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":237.579658175,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":237.579674084,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":237.579677696,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":237.579682066,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":237.579685402,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":237.579688274,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":237.579690852,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":237.579693994,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":237.579713039,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":237.579718605,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":237.579723334,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":237.579727478,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":237.579732434,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":237.579737144,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":237.579741005,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
