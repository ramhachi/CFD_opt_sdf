,{"stream_name":"stdout","time":264.989579529,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":264.989585078,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":264.989590633,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":264.989621691,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":264.9896257,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":264.989629261,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":264.9896397,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":264.989642562,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":264.989644965,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":264.989647564,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":264.989649914,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":264.989652357,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":264.989654775,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":264.989657088,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":264.989659551,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":264.989662041,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":264.989664413,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":264.989666869,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":264.989669109,"data":"end\n"}
