,{"stream_name":"stdout","time":238.161530477,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":238.161540892,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":238.16154478,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":238.161558297,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":238.161560773,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":238.161562952,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":238.161565578,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":238.161567888,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":238.161577288,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":238.161579618,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":238.161581883,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.161584953,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.161601384,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":238.161605306,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":238.161609576,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":238.161630092,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":238.16163425,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":238.161638395,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":238.161641933,"data":"end\n"}
