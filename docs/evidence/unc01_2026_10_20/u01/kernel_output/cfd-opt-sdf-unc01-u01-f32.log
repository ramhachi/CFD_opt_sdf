,{"stream_name":"stdout","time":245.338134036,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":245.33813854,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":245.338142743,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":245.338178007,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":245.338182389,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":245.338186091,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":245.338190276,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":245.338194237,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":245.33819817,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":245.33820145,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":245.338204883,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":245.338208267,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":245.338211683,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":245.338214996,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":245.338218387,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":245.338221819,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":245.338225117,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":245.338228516,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":245.338231746,"data":"end\n"}
