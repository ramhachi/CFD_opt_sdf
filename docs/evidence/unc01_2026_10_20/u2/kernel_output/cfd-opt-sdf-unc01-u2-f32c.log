,{"stream_name":"stdout","time":247.864813824,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":247.864819228,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":247.86482341,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":247.864840776,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":247.86484484,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":247.864848556,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":247.86485348,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":247.864857441,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":247.864861421,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":247.864864787,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":247.864868201,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":247.864871632,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":247.864875075,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":247.864878447,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":247.864881987,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":247.864885501,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":247.864888863,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":247.86489241,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":247.864895656,"data":"end\n"}
