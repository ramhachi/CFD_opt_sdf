,{"stream_name":"stdout","time":257.287832206,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":257.287837157,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":257.287841709,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":257.287860337,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":257.287864553,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":257.287868143,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":257.287872475,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":257.287876603,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":257.287880633,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":257.28788467,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":257.287888698,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":257.287892765,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":257.287896968,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":257.28790094,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":257.287904919,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":257.287908847,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":257.287912654,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
