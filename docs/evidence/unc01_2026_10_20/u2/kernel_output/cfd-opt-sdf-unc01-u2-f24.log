,{"stream_name":"stdout","time":268.778111983,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":268.778116676,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":268.778121242,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":268.778144741,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":268.778149865,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":268.778154068,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":268.778161961,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":268.778165891,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":268.778169469,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":268.778173126,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":268.778176837,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":268.778180558,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":268.778184251,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":268.778187899,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":268.778191719,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":268.778195545,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":268.778199157,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":268.778202992,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":268.778211976,"data":"end\n"}
