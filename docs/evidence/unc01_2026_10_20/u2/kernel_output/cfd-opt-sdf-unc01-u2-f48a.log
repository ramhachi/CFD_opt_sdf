,{"stream_name":"stdout","time":235.826935703,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":235.826939874,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":235.826943965,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":235.8269605,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":235.826964019,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":235.826967266,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":235.826970986,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":235.826974246,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":235.826979338,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":235.826987083,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":235.827002816,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":235.827007061,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":235.827011021,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":235.827015165,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":235.827019316,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":235.827022915,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":235.827026177,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":235.827029686,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":235.827032868,"data":"end\n"}
