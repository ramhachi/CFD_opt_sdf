,{"stream_name":"stdout","time":248.222152628,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":248.222156069,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":248.2221604,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":248.22216408,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":248.222167679,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":248.222171296,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":248.22217665,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":248.222183675,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":248.222186123,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":248.22218847,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":248.222190896,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":248.222193341,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":248.222195753,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
