,{"stream_name":"stdout","time":248.222122635,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":248.222127375,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":248.22213177,"data":"devs = collect(CUDA.devices())\n"}
