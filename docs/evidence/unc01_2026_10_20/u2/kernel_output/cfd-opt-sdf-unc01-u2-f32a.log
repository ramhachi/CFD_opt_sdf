,{"stream_name":"stdout","time":232.108541846,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":232.108546203,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":232.108550304,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":232.108568418,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":232.108572085,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":232.108575272,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":232.108579118,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":232.108582517,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":232.108587439,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":232.108595127,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":232.108598612,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":232.108613842,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":232.10861796,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":232.10862186,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":232.108626144,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":232.108630263,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":232.108633637,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":232.108637142,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":232.108640338,"data":"end\n"}
