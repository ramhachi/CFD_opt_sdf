,{"stream_name":"stdout","time":230.107408796,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":230.107414025,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":230.107418387,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":230.10743602,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":230.107439886,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":230.107443378,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":230.107447965,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":230.107452563,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":230.107456766,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":230.107460845,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":230.107464681,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":230.107468203,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":230.107471718,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":230.107475189,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":230.107478789,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":230.10748247,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":230.107486049,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
