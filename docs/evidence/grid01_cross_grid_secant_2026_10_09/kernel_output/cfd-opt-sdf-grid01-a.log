,{"stream_name":"stdout","time":234.539740277,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":234.539744882,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":234.539749242,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":234.539762818,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":234.539766653,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":234.539770248,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":234.539774775,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":234.539778584,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":234.539782282,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":234.53978583,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":234.539789623,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.53979319,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.539796916,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":234.539800463,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":234.539804147,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":234.539807883,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":234.53981175,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":234.539815454,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":234.539819077,"data":"end\n"}
