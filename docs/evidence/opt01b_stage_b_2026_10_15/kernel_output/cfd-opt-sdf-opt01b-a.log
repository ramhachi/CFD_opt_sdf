,{"stream_name":"stdout","time":247.186579885,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":247.186584657,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":247.186589523,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":247.186607278,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":247.186617888,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":247.186620611,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":247.186623582,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":247.186626131,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":247.186628605,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":247.186631062,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":247.186633463,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":247.18663592,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":247.186638543,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":247.186640978,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":247.186643552,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":247.186646045,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":247.186648396,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":247.186650862,"data":"    println(io, json)\n"}
