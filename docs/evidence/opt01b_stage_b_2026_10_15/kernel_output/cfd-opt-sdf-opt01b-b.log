,{"stream_name":"stdout","time":260.80197951,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":260.801984231,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":260.801988983,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":260.802024754,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":260.802030009,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":260.802034301,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":260.802039364,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":260.802044151,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":260.802048216,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":260.802052027,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":260.802055891,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":260.802059835,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":260.80206365,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":260.802067499,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":260.802071404,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":260.802075663,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":260.802079322,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":260.802083296,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":260.802087016,"data":"end\n"}
