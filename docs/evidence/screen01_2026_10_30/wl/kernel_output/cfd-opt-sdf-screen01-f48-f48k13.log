,{"stream_name":"stdout","time":273.847046697,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":273.847053461,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":273.847059025,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":273.847078736,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":273.847083027,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":273.84708671,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":273.847091138,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":273.847095128,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":273.847098887,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":273.847102665,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":273.847106427,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":273.847115515,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":273.8471326,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":273.84713734,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":273.847141828,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":273.847146251,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":273.847150755,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":273.84715535,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":273.847159084,"data":"end\n"}
