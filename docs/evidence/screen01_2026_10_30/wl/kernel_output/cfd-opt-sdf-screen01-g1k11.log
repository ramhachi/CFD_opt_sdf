,{"stream_name":"stdout","time":229.244805678,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":229.244810217,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":229.244814368,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":229.244834921,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":229.244838341,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":229.244855464,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":229.24486018,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":229.244864368,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":229.244867918,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":229.244871828,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":229.244875644,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":229.244879203,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":229.244882627,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":229.244886061,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":229.244889492,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":229.244893004,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":229.244896304,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":229.244899879,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":229.244903073,"data":"end\n"}
