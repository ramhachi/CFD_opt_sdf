,{"stream_name":"stdout","time":231.651959243,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":231.651963623,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":231.651967799,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":231.651998083,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":231.652004607,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":231.652008193,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":231.652012152,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":231.652015709,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":231.652019105,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":231.652022511,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":231.652026004,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":231.652029672,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":231.652033146,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":231.652036696,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":231.652040554,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":231.652044285,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":231.652056274,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
