,{"stream_name":"stdout","time":252.689162154,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":252.689167076,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":252.689171807,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":252.689190492,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":252.689194569,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":252.689198431,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":252.689205184,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":252.689213405,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":252.689231993,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":252.689237035,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":252.689241616,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":252.689246013,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":252.689250803,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":252.689254708,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":252.689258675,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":252.689262671,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":252.689266443,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":252.689270405,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":252.689274032,"data":"end\n"}
