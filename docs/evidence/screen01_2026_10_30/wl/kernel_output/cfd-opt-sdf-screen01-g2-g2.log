,{"stream_name":"stdout","time":238.954836891,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":238.954841467,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":238.954845748,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":238.954863647,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":238.954867518,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":238.954871574,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":238.954876503,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":238.954880909,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":238.954885058,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":238.954888997,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":238.954893235,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.954896968,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.954900582,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":238.954904195,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":238.954907917,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":238.95491166,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":238.954915247,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":238.954919081,"data":"    println(io, json)\n"}
