,{"stream_name":"stdout","time":250.302371025,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":250.302375821,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":250.302380248,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":250.302397958,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":250.302401506,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":250.30240477,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":250.302408998,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":250.302412427,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":250.302415671,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":250.302418975,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":250.302422266,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":250.30242546,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":250.302428668,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":250.302431902,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":250.30243546,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":250.302439248,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":250.302442333,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
