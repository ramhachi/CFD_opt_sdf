,{"stream_name":"stdout","time":272.892276289,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":272.892281579,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":272.892286379,"data":"devs = collect(CUDA.devices())\n"}
