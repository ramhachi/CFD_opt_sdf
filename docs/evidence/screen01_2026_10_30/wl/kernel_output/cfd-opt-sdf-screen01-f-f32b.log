,{"stream_name":"stdout","time":272.892306596,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":272.892310345,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":272.892315805,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":272.892321258,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":272.89232617,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":272.892330631,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":272.892334998,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":272.892338945,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":272.89234288,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
