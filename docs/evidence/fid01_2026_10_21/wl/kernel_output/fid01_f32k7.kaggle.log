,{"stream_name":"stdout","time":229.990144846,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":229.990149908,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":229.990153987,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":229.990170469,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":229.990174048,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":229.990177161,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":229.990181589,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":229.990186001,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":229.990189919,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":229.990193706,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":229.990197416,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":229.990200844,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":229.99020423,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":229.990207527,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":229.99021096,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":229.99021445,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":229.990217936,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
