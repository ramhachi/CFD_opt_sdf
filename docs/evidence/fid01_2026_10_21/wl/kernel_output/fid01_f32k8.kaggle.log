,{"stream_name":"stdout","time":245.370219415,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":245.370223832,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":245.37022798,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":245.370245104,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":245.370248687,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":245.370251922,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":245.370256025,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":245.370259539,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":245.370262881,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":245.370266263,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":245.370271283,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":245.370278398,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":245.370294267,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":245.370298581,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":245.370302651,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":245.370306875,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":245.370310658,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":245.370314658,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":245.370317905,"data":"end\n"}
