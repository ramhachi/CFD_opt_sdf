,{"stream_name":"stdout","time":249.366900604,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":249.366906366,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":249.366910798,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":249.366931038,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":249.366936076,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":249.366939594,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":249.36694377,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":249.366947478,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":249.366950953,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":249.36695446,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":249.366958462,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":249.366969768,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":249.366972258,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":249.366974626,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":249.366977083,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":249.366979564,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":249.3669843,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":249.366989094,"data":"    println(io, json)\n"}
