,{"stream_name":"stdout","time":230.644792688,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":230.644798145,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":230.644803104,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":230.64482166,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":230.644826035,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":230.644829643,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":230.644834034,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":230.644838903,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":230.64484285,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":230.644846641,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":230.644850399,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":230.644854069,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":230.6448578,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":230.644861926,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":230.644865809,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":230.644869795,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":230.644875016,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
