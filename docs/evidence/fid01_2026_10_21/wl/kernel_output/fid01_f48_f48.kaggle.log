,{"stream_name":"stdout","time":270.290608731,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":270.290615377,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":270.29062078,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":270.290648113,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":270.290651425,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":270.29065383,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":270.290656991,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":270.290659823,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":270.290662363,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":270.290665326,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":270.29066805,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":270.290671034,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":270.2906746,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":270.290677217,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":270.29067992,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":270.290682527,"data":"], \",\") * \"}\"\n"}
