,{"stream_name":"stdout","time":236.259227611,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":236.259232216,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":236.259236307,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":236.259252696,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":236.259257987,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":236.259280174,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":236.259285325,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":236.259289631,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":236.259293322,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":236.259296686,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":236.259300073,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":236.259303498,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":236.259306868,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":236.259310574,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":236.259313997,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":236.25931746,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":236.259320779,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":236.259324368,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":236.259327622,"data":"end\n"}
