FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application simpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 2000;
deltaT 1;
writeControl timeStep;
writeInterval 2000;
purgeWrite 1;
writeFormat ascii;
writePrecision 8;
runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type forceCoeffs;
        libs (forces);
        patches (airfoil);
        rho rhoInf;
        rhoInf 1;
        CofR (0.05585 0 0);
        writeControl timeStep;
        writeInterval 1;
        dragDir (1 0 0);
        liftDir (0 -1 0);
        pitchAxis (0 0 1);
        magUInf 30.0;
        lRef 0.2234;
        Aref 0.0004468;
    }
    forces
    {
        type forces;
        libs (forces);
        patches (airfoil);
        rho rhoInf;
        rhoInf 1;
        CofR (0.05585 0 0);
        writeControl timeStep;
        writeInterval 1;
    }
}
