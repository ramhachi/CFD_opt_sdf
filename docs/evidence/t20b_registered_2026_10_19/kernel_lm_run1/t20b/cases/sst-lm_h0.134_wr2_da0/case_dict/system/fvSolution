FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.1; }
    "(U|k|omega|nuTilda|ReThetat|gammaInt)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-10; relTol 0.1; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent no;
    residualControl
    {
        p 1e-6;
        U 1e-7;
        k 1e-6;
        omega 1e-6;
        ReThetat 1e-6;
        gammaInt 1e-6;
    }
}
relaxationFactors
{
    fields { p 0.2; }
    equations
    {
        U 0.5;
        "(k|omega|ReThetat|gammaInt)" 0.3;
    }
}
