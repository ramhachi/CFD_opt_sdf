FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object gammaInt;
}

dimensions [0 0 0 0 0 0 0];

internalField uniform 1;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 1;
    }
    outlet
    {
        type inletOutlet;
        inletValue uniform 1;
        value uniform 1;
    }
    top
    {
        type zeroGradient;
    }
    ground
    {
        type zeroGradient;
    }
    airfoil
    {
        type zeroGradient;
    }
    front
    {
        type empty;
    }
    back
    {
        type empty;
    }
}
