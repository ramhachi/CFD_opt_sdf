,{"stream_name":"stdout","time":234.554278655,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":234.55428298,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":234.554292779,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":234.554315539,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":234.554318098,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":234.554320227,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":234.554323019,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":234.55432534,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":234.554327521,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":234.554329781,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":234.554332781,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.554348385,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.554352503,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":234.554373806,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":234.554377852,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":234.554382194,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":234.554401566,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":234.554405862,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":234.55440936,"data":"end\n"}
