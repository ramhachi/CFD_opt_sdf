,{"stream_name":"stdout","time":242.521262839,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":242.521267585,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":242.521272134,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":242.521288532,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":242.521310071,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":242.521314162,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":242.521318417,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":242.52132256,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":242.521326577,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":242.521330131,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":242.521333556,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":242.521336712,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":242.521340102,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":242.521343714,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":242.521347191,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":242.521350603,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":242.521353946,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":242.521357499,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":242.52136093,"data":"end\n"}
