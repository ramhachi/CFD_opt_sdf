,{"stream_name":"stdout","time":234.622081158,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":234.622086061,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":234.622090426,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":234.622109244,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":234.62211243,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":234.622114698,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":234.622117447,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":234.622119879,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":234.622122392,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":234.622137957,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":234.622142308,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.622146045,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":234.622150175,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":234.62215433,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":234.622158175,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":234.622161937,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":234.62216554,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":234.622169234,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":234.62217274,"data":"end\n"}
