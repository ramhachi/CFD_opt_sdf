,{"stream_name":"stdout","time":235.552486136,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":235.55249098,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":235.552494722,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":235.552512159,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":235.55251598,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":235.552519267,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":235.552523043,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":235.552526673,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":235.552529897,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":235.5525334,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":235.552536932,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":235.55254031,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":235.55254359,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":235.55254745,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":235.552551029,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":235.552554676,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":235.55255804,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":235.552561592,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":235.552564972,"data":"end\n"}
