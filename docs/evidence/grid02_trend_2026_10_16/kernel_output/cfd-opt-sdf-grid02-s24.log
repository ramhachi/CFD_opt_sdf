,{"stream_name":"stdout","time":238.635111919,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":238.635116129,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":238.635120231,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":238.635136244,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":238.635139694,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":238.635142969,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":238.635146693,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":238.635150275,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":238.635155016,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":238.635162619,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":238.635179681,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.635184083,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.635188014,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":238.635191663,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":238.635196019,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":238.635199667,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":238.635202924,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":238.635206427,"data":"    println(io, json)\n"}
,{"stream_name":"stdout","time":238.635209656,"data":"end\n"}
