,{"stream_name":"stdout","time":244.54935228,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":244.54935697,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":244.549361496,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":244.549379501,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":244.549383919,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":244.549387426,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":244.549391664,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":244.54939736,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":244.549405132,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":244.54942289,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":244.549427618,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":244.549431898,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":244.549436346,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":244.549440535,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":244.549444387,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":244.549448152,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":244.549451755,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
,{"stream_name":"stdout","time":244.549455495,"data":"    println(io, json)\n"}
