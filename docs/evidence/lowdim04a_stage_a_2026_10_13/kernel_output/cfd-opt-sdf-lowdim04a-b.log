,{"stream_name":"stdout","time":238.937490184,"data":"using CUDA\n"}
,{"stream_name":"stdout","time":238.937493829,"data":"@assert CUDA.functional()\n"}
,{"stream_name":"stdout","time":238.937496899,"data":"devs = collect(CUDA.devices())\n"}
,{"stream_name":"stdout","time":238.937512368,"data":"id(d) = \"GPU-\" * string(CUDA.uuid(d))\n"}
,{"stream_name":"stdout","time":238.937530025,"data":"Q = string(Char(34))\n"}
,{"stream_name":"stdout","time":238.937533888,"data":"q(x) = (s = string(x); @assert !occursin(Q, s) \u0026\u0026 !occursin(string(Char(92)), s); Q * s * Q)\n"}
,{"stream_name":"stdout","time":238.937538977,"data":"arr(v) = \"[\" * join(q.(v), \",\") * \"]\"\n"}
,{"stream_name":"stdout","time":238.937543216,"data":"kv(k, v) = q(k) * \":\" * v\n"}
,{"stream_name":"stdout","time":238.937547185,"data":"json = \"{\" * join([\n"}
,{"stream_name":"stdout","time":238.937551247,"data":"    kv(\"logical_device_count\", string(length(devs))),\n"}
,{"stream_name":"stdout","time":238.937555077,"data":"    kv(\"visible_gpu_names\", arr([CUDA.name(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.937559026,"data":"    kv(\"visible_gpu_uuids\", arr([id(d) for d in devs])),\n"}
,{"stream_name":"stdout","time":238.937562636,"data":"    kv(\"default_device_uuid\", q(id(CUDA.device()))),\n"}
,{"stream_name":"stdout","time":238.937566162,"data":"    kv(\"cuda_device_order\", q(ENV[\"CUDA_DEVICE_ORDER\"])),\n"}
,{"stream_name":"stdout","time":238.937569865,"data":"    kv(\"cuda_visible_devices\", q(ENV[\"CUDA_VISIBLE_DEVICES\"])),\n"}
,{"stream_name":"stdout","time":238.937573692,"data":"], \",\") * \"}\"\n"}
,{"stream_name":"stdout","time":238.937577111,"data":"open(ENV[\"GRID01_GPU_PROBE_OUT\"], \"w\") do io\n"}
